NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY_INR=799
NEXT_PUBLIC_PRO_PRICE_MONTHLY_PER_MONTH_INR=799
NEXT_PUBLIC_PRO_PRICE_ANNUAL_DISPLAY_INR=6999
NEXT_PUBLIC_PRO_PRICE_ANNUAL_ACTUAL_INR=9588
NEXT_PUBLIC_PRO_PRICE_ANNUAL_PER_MONTH_INR=583.25
