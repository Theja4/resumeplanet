# AUD
NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY_AUD=19.99
NEXT_PUBLIC_PRO_PRICE_MONTHLY_PER_MONTH_AUD=19.99
NEXT_PUBLIC_PRO_PRICE_ANNUAL_DISPLAY_AUD=149
NEXT_PUBLIC_PRO_PRICE_ANNUAL_ACTUAL_AUD=239.88
NEXT_PUBLIC_PRO_PRICE_ANNUAL_PER_MONTH_AUD=12.42
NEXT_PUBLIC_PRO_PRICE_ANNUAL_SAVINGS_AUD=Save A$90.88 vs monthly
