# Supabase
# If you activate a Supabase custom domain or vanity subdomain, use that URL here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paddle (replaces Stripe — Paddle is Merchant of Record, handles all VAT/GST automatically)
# Get from: Paddle dashboard → Developer → Authentication

# Server-side only (never expose to client)
PADDLE_API_KEY=pdl_sdbx_...

# Webhook signature secret
# Paddle dashboard → Notifications → your endpoint
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# Client-side token (safe to expose)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...

# Pro subscription price IDs (create in Paddle dashboard → Catalog → Products)
PADDLE_PRO_PRICE_MONTHLY=pri_...
PADDLE_PRO_PRICE_ANNUAL=pri_...
PADDLE_PRO_PRICE_WEEKLY=pri_...

# Optional regional Pro subscription price IDs (local currencies)
# If set, checkout + pricing UI auto-switch by visitor country.
# USD is used as fallback for all countries without a configured regional price.
PADDLE_PRO_PRICE_MONTHLY_EUR=pri_...
PADDLE_PRO_PRICE_ANNUAL_EUR=pri_...
PADDLE_PRO_PRICE_WEEKLY_EUR=pri_...
PADDLE_PRO_PRICE_MONTHLY_GBP=pri_...
PADDLE_PRO_PRICE_ANNUAL_GBP=pri_...
PADDLE_PRO_PRICE_WEEKLY_GBP=pri_...
PADDLE_PRO_PRICE_MONTHLY_INR=pri_...
PADDLE_PRO_PRICE_ANNUAL_INR=pri_...
PADDLE_PRO_PRICE_WEEKLY_INR=pri_...
PADDLE_PRO_PRICE_MONTHLY_AUD=pri_...
PADDLE_PRO_PRICE_ANNUAL_AUD=pri_...
PADDLE_PRO_PRICE_WEEKLY_AUD=pri_...
PADDLE_PRO_PRICE_MONTHLY_CAD=pri_...
PADDLE_PRO_PRICE_ANNUAL_CAD=pri_...
PADDLE_PRO_PRICE_WEEKLY_CAD=pri_...

# Professional writing product ID (one-time payment product)
PADDLE_PROFESSIONAL_PRODUCT_ID=pro_...
# Professional resume writing one-time price ID (create a one-time price on the product)
PADDLE_PROFESSIONAL_ORDER_PRICE_ID=pri_...

# Environment: 'sandbox' for testing, 'production' for live
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Discount IDs for promotions (Paddle dashboard → Catalog → Discounts)
PADDLE_DISCOUNT_DIWALI_2026=
PADDLE_DISCOUNT_NEWYEAR_2027=
PADDLE_DISCOUNT_EXIT_DEFAULT=

# Pricing display values (easy knobs, safe to expose)
# USD
NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY_USD=12
NEXT_PUBLIC_PRO_PRICE_MONTHLY_PER_MONTH_USD=12
NEXT_PUBLIC_PRO_PRICE_ANNUAL_DISPLAY_USD=99
NEXT_PUBLIC_PRO_PRICE_ANNUAL_ACTUAL_USD=144
NEXT_PUBLIC_PRO_PRICE_ANNUAL_PER_MONTH_USD=8.25
NEXT_PUBLIC_PRO_PRICE_ANNUAL_SAVINGS_USD=Save $45 vs monthly
NEXT_PUBLIC_PRO_PRICE_WEEKLY_DISPLAY_USD=4.99
# EUR
NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY_EUR=11
NEXT_PUBLIC_PRO_PRICE_MONTHLY_PER_MONTH_EUR=11
NEXT_PUBLIC_PRO_PRICE_ANNUAL_DISPLAY_EUR=89
NEXT_PUBLIC_PRO_PRICE_ANNUAL_ACTUAL_EUR=132
NEXT_PUBLIC_PRO_PRICE_ANNUAL_PER_MONTH_EUR=7.42
NEXT_PUBLIC_PRO_PRICE_ANNUAL_SAVINGS_EUR=Save €43 vs monthly
NEXT_PUBLIC_PRO_PRICE_WEEKLY_DISPLAY_EUR=4.49
# GBP
NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY_GBP=10
NEXT_PUBLIC_PRO_PRICE_MONTHLY_PER_MONTH_GBP=10
NEXT_PUBLIC_PRO_PRICE_ANNUAL_DISPLAY_GBP=79
NEXT_PUBLIC_PRO_PRICE_ANNUAL_ACTUAL_GBP=120
NEXT_PUBLIC_PRO_PRICE_ANNUAL_PER_MONTH_GBP=6.58
NEXT_PUBLIC_PRO_PRICE_ANNUAL_SAVINGS_GBP=Save £41 vs monthly
NEXT_PUBLIC_PRO_PRICE_WEEKLY_DISPLAY_GBP=3.99
# INR
NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY_INR=799
NEXT_PUBLIC_PRO_PRICE_MONTHLY_PER_MONTH_INR=799
NEXT_PUBLIC_PRO_PRICE_ANNUAL_DISPLAY_INR=6999
NEXT_PUBLIC_PRO_PRICE_ANNUAL_ACTUAL_INR=9588
NEXT_PUBLIC_PRO_PRICE_ANNUAL_PER_MONTH_INR=583.25
NEXT_PUBLIC_PRO_PRICE_ANNUAL_SAVINGS_INR=Save ₹2,589 vs monthly
NEXT_PUBLIC_PRO_PRICE_WEEKLY_DISPLAY_INR=349
# AUD
NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY_AUD=19.99
NEXT_PUBLIC_PRO_PRICE_MONTHLY_PER_MONTH_AUD=19.99
NEXT_PUBLIC_PRO_PRICE_ANNUAL_DISPLAY_AUD=149
NEXT_PUBLIC_PRO_PRICE_ANNUAL_ACTUAL_AUD=239.88
NEXT_PUBLIC_PRO_PRICE_ANNUAL_PER_MONTH_AUD=12.42
NEXT_PUBLIC_PRO_PRICE_ANNUAL_SAVINGS_AUD=Save A$90.88 vs monthly
NEXT_PUBLIC_PRO_PRICE_WEEKLY_DISPLAY_AUD=6.99
# CAD
NEXT_PUBLIC_PRO_PRICE_MONTHLY_DISPLAY_CAD=19.99
NEXT_PUBLIC_PRO_PRICE_MONTHLY_PER_MONTH_CAD=19.99
NEXT_PUBLIC_PRO_PRICE_ANNUAL_DISPLAY_CAD=149
NEXT_PUBLIC_PRO_PRICE_ANNUAL_ACTUAL_CAD=239.88
NEXT_PUBLIC_PRO_PRICE_ANNUAL_PER_MONTH_CAD=12.42
NEXT_PUBLIC_PRO_PRICE_ANNUAL_SAVINGS_CAD=Save CA$90.88 vs monthly
NEXT_PUBLIC_PRO_PRICE_WEEKLY_DISPLAY_CAD=6.99

# Promotion discount controls (easy knobs, safe to expose)
NEXT_PUBLIC_PROMO_DIWALI_2026_PERCENT=50
NEXT_PUBLIC_PROMO_NEWYEAR_2027_PERCENT=30
NEXT_PUBLIC_PROMO_EXIT_DEFAULT_FIXED=6

# Affiliate program controls (easy knobs, safe to expose)
NEXT_PUBLIC_AFFILIATE_DISCOUNT_PERCENT=50
NEXT_PUBLIC_AFFILIATE_COMMISSION_PERCENT=40

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SESSION_SECRET=change-this-admin-session-secret
NEXT_PUBLIC_ENABLE_ADS=false

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Jobs
JOBS_SYNC_SECRET=change-me
CRON_SECRET=
GREENHOUSE_BOARD_TOKENS=
LEVER_SITE_NAMES=
REMOTIVE_ENABLED=true
REMOTIVE_JOB_LIMIT=120
