# Supabase
# If you activate a Supabase custom domain or vanity subdomain, use that URL here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Rezoomed <onboarding@resend.dev>
RESEND_REPLY_TO=support@rezoomed.com
EMAIL_ASSET_BASE_URL=https://rezoomed.com
EMAIL_POLICY_URL=https://rezoomed.com/terms
EMAIL_BROWSER_URL=https://rezoomed.com/terms

# Paddle (replaces Stripe — Paddle is Merchant of Record, handles all VAT/GST automatically)
# Get from: Paddle dashboard → Developer → Authentication

# Server-side only (never expose to client)
PADDLE_API_KEY=pdl_sdbx_...

# Webhook signature secret
# Paddle dashboard → Notifications → your endpoint
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# Client-side token (safe to expose)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...

# Pro subscription price IDs (create in Paddle dashboard → Catalog → Products)
PADDLE_PRO_PRICE_MONTHLY=pri_...
PADDLE_PRO_PRICE_ANNUAL=pri_...
PADDLE_PRO_PRICE_WEEKLY=pri_...

# Optional regional Pro subscription price IDs (local currencies)
# If set, checkout + pricing UI auto-switch by visitor country.
# USD is used as fallback for all countries without a configured regional price.
PADDLE_PRO_PRICE_MONTHLY_EUR=pri_...
PADDLE_PRO_PRICE_ANNUAL_EUR=pri_...
PADDLE_PRO_PRICE_WEEKLY_EUR=pri_...
PADDLE_PRO_PRICE_MONTHLY_GBP=pri_...
PADDLE_PRO_PRICE_ANNUAL_GBP=pri_...
PADDLE_PRO_PRICE_WEEKLY_GBP=pri_...
PADDLE_PRO_PRICE_MONTHLY_INR=pri_...
PADDLE_PRO_PRICE_ANNUAL_INR=pri_...
PADDLE_PRO_PRICE_WEEKLY_INR=pri_...
PADDLE_PRO_PRICE_MONTHLY_AUD=pri_...
PADDLE_PRO_PRICE_ANNUAL_AUD=pri_...
PADDLE_PRO_PRICE_WEEKLY_AUD=pri_...
PADDLE_PRO_PRICE_MONTHLY_CAD=pri_...
PADDLE_PRO_PRICE_ANNUAL_CAD=pri_...
PADDLE_PRO_PRICE_WEEKLY_CAD=pri_...

# Professional writing product ID (one-time payment product)
PADDLE_PROFESSIONAL_PRODUCT_ID=pro_...
# Professional resume writing one-time price ID (create a one-time price on the product)
PADDLE_PROFESSIONAL_ORDER_PRICE_ID=pri_...

# Environment: 'sandbox' for testing, 'production' for live
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Payment provider switch. Set "paddle" only when Paddle is approved again.
NEXT_PUBLIC_PAYMENT_PROVIDER=paypal
NEXT_PUBLIC_PAYPAL_CHECKOUT_ENABLED=true
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRO_PLAN_MONTHLY=
PAYPAL_PRO_PLAN_ANNUAL=

# Razorpay India checkout
# Use test keys locally. Keep RAZORPAY_KEY_SECRET server-side only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_MONTHLY=plan_...
RAZORPAY_PRO_PLAN_ANNUAL=plan_...
RAZORPAY_PRO_PLAN_MONTHLY_DISCOUNT=plan_...
RAZORPAY_PRO_PLAN_ANNUAL_DISCOUNT=plan_...

# Keep these inactive until the USD PayPal subscription flow is verified.
# PayPal recurring subscriptions need one plan ID per currency and interval.
# PAYPAL_PRO_PLAN_MONTHLY_EUR=
# PAYPAL_PRO_PLAN_ANNUAL_EUR=
# PAYPAL_PRO_PLAN_MONTHLY_GBP=
# PAYPAL_PRO_PLAN_ANNUAL_GBP=
# PAYPAL_PRO_PLAN_MONTHLY_INR=
# PAYPAL_PRO_PLAN_ANNUAL_INR=
# PAYPAL_PRO_PLAN_MONTHLY_AUD=
# PAYPAL_PRO_PLAN_ANNUAL_AUD=
# PAYPAL_PRO_PLAN_MONTHLY_CAD=
# PAYPAL_PRO_PLAN_ANNUAL_CAD=

# Discount IDs for promotions (Paddle dashboard → Catalog → Discounts)
PADDLE_DISCOUNT_DIWALI_2026=
PADDLE_DISCOUNT_NEWYEAR_2027=
PADDLE_DISCOUNT_EXIT_DEFAULT=
POLAR_DISCOUNT_JOBS50_ID=

