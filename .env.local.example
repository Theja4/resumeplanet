# Promotion discount controls (easy knobs, safe to expose)
NEXT_PUBLIC_PROMO_DIWALI_2026_PERCENT=50
NEXT_PUBLIC_PROMO_NEWYEAR_2027_PERCENT=30
NEXT_PUBLIC_PROMO_EXIT_DEFAULT_FIXED=6

# Affiliate program controls (easy knobs, safe to expose)
NEXT_PUBLIC_AFFILIATE_DISCOUNT_PERCENT=50
NEXT_PUBLIC_AFFILIATE_COMMISSION_PERCENT=40

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SESSION_SECRET=change-this-admin-session-secret
NEXT_PUBLIC_ENABLE_ADS=false

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phx_your_project_api_key
POSTHOG_HOST=https://us.i.posthog.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Jobs
JOBS_SYNC_SECRET=change-me
CRON_SECRET=
GREENHOUSE_BOARD_TOKENS=
LEVER_SITE_NAMES=
REMOTIVE_ENABLED=true
REMOTIVE_JOB_LIMIT=120

# Chrome extension auth — JWT signing secret used by /api/extension/* routes.
# Must be at least 32 chars. Rotate by issuing a new value; live tokens become
# invalid and extensions silently re-auth via launchWebAuthFlow.
EXTENSION_JWT_SECRET=change-me-to-32-plus-random-bytes
